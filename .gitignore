# ---- Local secrets ----
.env
.env.*
!.env.example

# ---- dbt ----
# profiles.yml is generated by dbt-bootstrap and may contain env_var() refs only,
# but is kept local so per-developer targets never collide.
profiles.yml
dbt/target/
dbt/dbt_packages/
dbt/logs/

# ---- Pipeline runtime state ----
# Watermark checkpoints are per-environment. A missing watermark makes the next
# run do a full initial load, which is the intended fresh-clone behaviour.
pipeline/state/*.json

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/

# ---- Editor / OS ----
.vscode/
.idea/
.DS_Store
Thumbs.db
